COOKIE_SECRET=replace-with-a-long-random-secret
# Docker client is published on 3002 (AMS uses 3001). Host nginx still owns 80/443.
CLIENT_ORIGIN=http://localhost:3002
COOKIE_SECURE=false
# Leave empty so the browser talks to /api on the same host (nginx proxies to the server).
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3002/api/auth/github/callback
# Atlas (required on EC2 — do not run Mongo on the instance).
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/storage-app-v2?appName=Cluster0
API_UPSTREAM=http://server:4000

# EC2 + nginx:
# CLIENT_ORIGIN=https://storage.akashkadam.dev
# COOKIE_SECURE=true
# GITHUB_CALLBACK_URL=https://storage.akashkadam.dev/api/auth/github/callback
