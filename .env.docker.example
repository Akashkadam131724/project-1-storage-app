COOKIE_SECRET=replace-with-a-long-random-secret
# Docker client is published on 3002 (AMS uses 3001). Host nginx still owns 80/443.
CLIENT_ORIGIN=http://localhost:3002
COOKIE_SECURE=false
# Local docker: leave empty (client nginx proxies /api).
# EC2 image build: https://storage-api.akashkadam.dev
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local docker (client nginx proxies /api). Prod: https://storage-api.akashkadam.dev/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3002/api/auth/github/callback
# Atlas (required on EC2 — do not run Mongo on the instance).
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/storage-app-v2?appName=Cluster0
API_UPSTREAM=http://server:4000

# Signup/login/reset codes via Resend. Verify the domain, then set both.
RESEND_KEY=
RESEND_FROM=Storage <no-reply@akashkadam.dev>
OTP_ECHO_CODE=false

# GitHub Actions secrets (client image bake):
#   VITE_API_URL=https://storage-api.akashkadam.dev
#   VITE_GOOGLE_CLIENT_ID=<same as GOOGLE_CLIENT_ID>
#
# EC2 server/.env:
#   CLIENT_ORIGIN=https://storage.akashkadam.dev
#   COOKIE_SECURE=true
#   GITHUB_CALLBACK_URL=https://storage-api.akashkadam.dev/api/auth/github/callback
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
#   RESEND_KEY / RESEND_FROM
#   OTP_ECHO_CODE=false
