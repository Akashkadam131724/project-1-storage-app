{
  "info": {
    "_postman_id": "a8c3f4e1-6b2d-4f91-9c0a-1d5e7b8a2c34",
    "name": "Storage App v2",
    "description": "Backend API for Storage App v2. Auth uses the signed `sid` cookie — enable the cookie jar in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "email",
      "value": "ada@storage.app"
    },
    {
      "key": "password",
      "value": "password1"
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "googleIdToken",
      "value": ""
    },
    {
      "key": "githubCode",
      "value": ""
    },
    {
      "key": "resetCode",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "folderId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "destFolderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Liveness check. No auth."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Email signup, password login, Google/GitHub, password reset, and logout. The signed `sid` cookie is set on login.",
      "item": [
        {
          "name": "Request signup code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.code) {",
                  "  pm.collectionVariables.set('code', json.data.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/otp",
            "description": "Sends a 4-digit signup code. In non-production the code is returned in `data.code` (also logged on the server)."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"code\": \"{{code}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates the user and a Home directory. Requires a valid code from Request signup code."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Sets a signed httpOnly `sid` cookie."
          }
        },
        {
          "name": "Login with Google",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/google",
            "description": "Verifies a Google Identity Services ID token and sets the `sid` cookie. Returns 503 if GOOGLE_CLIENT_ID is not set."
          }
        },
        {
          "name": "Start GitHub login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/github/start",
            "description": "Returns `{ url }` for the GitHub authorize page and sets a short-lived `gh_oauth_state` cookie. Open `data.url` in a browser. Returns 503 if GitHub OAuth is not configured."
          }
        },
        {
          "name": "Login with GitHub code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{githubCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/github",
            "description": "Exchanges a GitHub OAuth code for a session. Use this from Postman after copying `code` from the callback URL. Browser flow uses GET /api/auth/github/callback instead."
          }
        },
        {
          "name": "Forgot password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.code) {",
                  "  pm.collectionVariables.set('resetCode', json.data.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/password/forgot",
            "description": "Always returns 200. In non-production a reset code is returned in `data.code` when the account exists."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{resetCode}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/password/reset",
            "description": "Sets a new password and invalidates every session for that account."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Deletes the session and clears the cookie."
          }
        },
        {
          "name": "Logout all sessions",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout-all",
            "description": "Deletes every session for the signed-in user and clears the cookie."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Current user profile, password, and account. Admin routes list and manage other users. Requires the `sid` cookie.",
      "item": [
        {
          "name": "Get me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('userId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Returns the signed-in profile, including `authProvider` and `hasPassword`."
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\"\n}"
            },
            "url": "{{baseUrl}}/api/users/me",
            "description": "Updates the display name. Profile photo upload waits on storage."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"password2\"\n}"
            },
            "url": "{{baseUrl}}/api/users/me/password",
            "description": "Changes password for accounts that already have one."
          }
        },
        {
          "name": "Set password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/me/password",
            "description": "Sets the first password on a Google/GitHub-only account. Returns 409 if a password already exists."
          }
        },
        {
          "name": "Disable my account",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/users/me/disable",
            "description": "Soft-deletes the current account and signs out every session."
          }
        },
        {
          "name": "Delete my account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Permanently deletes the current account, sessions, and folders."
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?page=1&limit=20",
            "description": "Admin only. Paginated list of accounts. Query: `page` (default 1), `limit` (default 20, max 100)."
          }
        },
        {
          "name": "Logout user sessions",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}/logout",
            "description": "Admin only. Signs the target user out of every device."
          }
        },
        {
          "name": "Disable user",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}/disable",
            "description": "Admin only. Soft-deletes another account."
          }
        },
        {
          "name": "Restore user",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}/restore",
            "description": "Admin only. Re-enables a soft-deleted account."
          }
        },
        {
          "name": "Change user role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"User\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/role",
            "description": "Admin only. Role is `User` or `Admin`."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "description": "Admin only. Permanently deletes another account."
          }
        }
      ]
    },
    {
      "name": "Directories",
      "description": "Folders. Home is created at signup. Requires the `sid` cookie.",
      "item": [
        {
          "name": "List Home",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.folder && json.data.folder.id) {",
                  "  pm.collectionVariables.set('folderId', json.data.folder.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/directories?page=1&limit=20",
            "description": "Lists Home. Child `folders` and `files` are paginated (`items`, `page`, `limit`, `total`, `totalPages`)."
          }
        },
        {
          "name": "List folder",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/directories/{{folderId}}?page=1&limit=20",
            "description": "Lists a folder the user owns. Child folders and files are paginated."
          }
        },
        {
          "name": "Create folder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('folderId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Docs\"\n}"
            },
            "url": "{{baseUrl}}/api/directories",
            "description": "Creates a folder. Optional `parentId` defaults to Home."
          }
        },
        {
          "name": "Rename folder",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Documents\"\n}"
            },
            "url": "{{baseUrl}}/api/directories/{{folderId}}",
            "description": "Renames a folder. Home cannot be renamed."
          }
        },
        {
          "name": "Move folder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": \"{{destFolderId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/directories/{{folderId}}/move",
            "description": "Moves a folder. Cannot move Home, or a folder into itself."
          }
        },
        {
          "name": "Copy folder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": \"{{destFolderId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/directories/{{folderId}}/copy",
            "description": "Copies a folder tree. Omit `parentId` to copy next to the original. Name gets ` (copy)` if needed."
          }
        },
        {
          "name": "Star folder",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/directories/{{folderId}}/star",
            "description": "Stars a folder."
          }
        },
        {
          "name": "Unstar folder",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/directories/{{folderId}}/unstar",
            "description": "Removes a folder from starred."
          }
        },
        {
          "name": "Trash folder",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/directories/{{folderId}}",
            "description": "Soft-deletes a folder. Descendants stay as they are and are hidden until restore. Home cannot be trashed. Storage is not freed."
          }
        },
        {
          "name": "Restore folder",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/directories/{{folderId}}/restore",
            "description": "Restores a trashed folder in place. 409 NAME_TAKEN if a live sibling already uses the name."
          }
        },
        {
          "name": "Permanently delete folder",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/directories/{{folderId}}/permanent",
            "description": "Deletes a folder, its descendants, and their blobs. Frees storage. Home cannot be deleted."
          }
        }
      ]
    },
    {
      "name": "Files",
      "description": "Upload to local disk (S3 later). Requires the `sid` cookie. Field name for upload is `file`.",
      "item": [
        {
          "name": "Upload file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('fileId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "parentId",
                  "value": "{{folderId}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/files",
            "description": "Multipart upload. Omit `parentId` to store in Home. Max 100 MB."
          }
        },
        {
          "name": "Get file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}",
            "description": "File metadata (not the bytes)."
          }
        },
        {
          "name": "Download file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}/content",
            "description": "Downloads the file bytes."
          }
        },
        {
          "name": "Rename file",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"notes.txt\"\n}"
            },
            "url": "{{baseUrl}}/api/files/{{fileId}}",
            "description": "Renames a file in its current folder."
          }
        },
        {
          "name": "Move file",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": \"{{destFolderId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/files/{{fileId}}/move",
            "description": "Moves a file into another folder the user owns."
          }
        },
        {
          "name": "Copy file",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": \"{{destFolderId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/files/{{fileId}}/copy",
            "description": "Copies a file. Omit `parentId` to copy into the same folder. Name gets ` (copy)` if needed."
          }
        },
        {
          "name": "Star file",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}/star",
            "description": "Stars a file."
          }
        },
        {
          "name": "Unstar file",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}/unstar",
            "description": "Removes a file from starred."
          }
        },
        {
          "name": "Trash file",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}",
            "description": "Soft-deletes a file. Storage is not freed until permanent delete."
          }
        },
        {
          "name": "Restore file",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}/restore",
            "description": "Restores a trashed file in place. 409 NAME_TAKEN if a live sibling already uses the name."
          }
        },
        {
          "name": "Permanently delete file",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/files/{{fileId}}/permanent",
            "description": "Deletes the file and its stored bytes. Frees storage."
          }
        }
      ]
    },
    {
      "name": "Library",
      "description": "Drive views. Requires the `sid` cookie.",
      "item": [
        {
          "name": "List trash",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trash?page=1&limit=20",
            "description": "Paginated folders and files that were explicitly moved to trash."
          }
        },
        {
          "name": "List starred",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/starred?page=1&limit=20",
            "description": "Paginated starred folders and files that are not in trash."
          }
        },
        {
          "name": "List recent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/recent?page=1&limit=20",
            "description": "Paginated files recently opened via metadata or download."
          }
        }
      ]
    }
  ]
}
