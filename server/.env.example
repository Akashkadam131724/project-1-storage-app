NODE_ENV=development
# 4000 so it does not collide with AMS API on 3004
PORT=4000
# Vite local UI (AMS client is 3000)
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/storage-app-v2
COOKIE_SECRET=replace-with-a-long-random-secret
# Set false on plain HTTP (EC2 without TLS). Defaults to true in production.
COOKIE_SECURE=

# Google OAuth Web client. Needs both ID and secret for the auth-code popup.
# Console: Authorized JavaScript origins = CLIENT_ORIGIN
#          Authorized redirect URIs = CLIENT_ORIGIN and https://developers.google.com/oauthplayground
#          (popup auth-code uses redirect_uri=postmessage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App. Callback must match exactly.
# Local:  http://127.0.0.1:4000/api/auth/github/callback
# Prod:   https://YOUR_API_HOST/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:4000/api/auth/github/callback

# Local file blobs (S3 comes later). Directory is created automatically.
UPLOAD_DIR=storage/blobs

# Drive quotas in bytes (defaults: 500 MB accounts, 25 MB guests).
MAX_STORAGE_BYTES=524288000
GUEST_STORAGE_BYTES=26214400

# Resend for signup, login, and password-reset codes.
# Verify the domain in Resend, then set from to an address on that domain.
# Required in production unless OTP_ECHO_CODE=true.
RESEND_KEY=
RESEND_FROM=Storage <no-reply@akashkadam.dev>
# Set true only to echo the code in the API (tests do this automatically).
OTP_ECHO_CODE=false

