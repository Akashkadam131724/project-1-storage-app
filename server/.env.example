NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/storage-app-v2
COOKIE_SECRET=replace-with-a-long-random-secret

# Google Identity Services ID token (SPA). Leave empty to disable.
GOOGLE_CLIENT_ID=

# GitHub OAuth App. Leave empty to disable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:4000/api/auth/github/callback

